{
  "expo": {
    "name": "tradeable.",
    "slug": "tradeable-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#2A2233",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.tradeable.companion"
    },
    "android": {
      "package": "app.tradeable.companion",
      "adaptiveIcon": {
        "backgroundColor": "#2A2233",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "tradeable. uses the camera to read the set code and number on your cards.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
